# ==========================================
# Full-Stack Application Environment Variables
# ==========================================

# Django Backend Configuration
SECRET_KEY=generate-a-secure-random-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://localhost:8080
BACKEND_PORT=8000

# React Frontend Configuration
# Leave as http://localhost:8000 for direct browser-to-backend communication,
# or set to empty string "" to use the NGINX /api/ reverse proxy.
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=80

